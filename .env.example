# Server Environment & Port Configuration
PORT=5001
NODE_ENV="development" # development | production
AUTH_MODE="development" # development | production

# Frontend Cross-Origin Resource Sharing (CORS)
FRONTEND_URL="http://localhost:5173"

# SQLite / Database Connection URL
DATABASE_URL="file:./dev.db"

# JWT Token Secret (REQUIRED in production mode)
JWT_SECRET="your_production_jwt_secret_key_change_me"

# Gmail SMTP Configuration for Real Verification OTP Delivery
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="sender_email@gmail.com"
SMTP_PASS="your_16_char_google_app_password"
SMTP_SECURE="false"
EMAIL_FROM="Tribal Scholar AI <no-reply@mota.gov.in>"

# AI Provider Configuration (Optional / Deterministic Fallback Mode)
DEMO_AI_MODE="true"
