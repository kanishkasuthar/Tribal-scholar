# Environment Variables Configuration Example - Tribal Scholar AI
# Copy this file to .env in backend directory. DO NOT commit actual secrets.

PORT=5001
DATABASE_URL="file:../prisma/dev.db"
JWT_SECRET="tribal_scholar_ai_super_secret_jwt_key_2026"
NODE_ENV="development"
FRONTEND_URL="http://localhost:5173"

# Real Gmail / SMTP Email Delivery Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your.application.sender@gmail.com"
SMTP_PASS="16_char_google_app_password"
SMTP_SECURE="false"
EMAIL_FROM="Tribal Scholar AI <your.application.sender@gmail.com>"
